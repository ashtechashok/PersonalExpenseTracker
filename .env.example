# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by the running app.
# Self-hosted Postgres: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Neon: use the POOLED connection string from your project's dashboard (the
# one with "-pooler" in the hostname) — see DEPLOY_VERCEL.md.
DATABASE_URL="postgresql://expense_tracker:CHANGE_ME@localhost:5432/expense_tracker?schema=public"

# Direct (unpooled) connection string, used only by `prisma migrate deploy` —
# DDL and advisory locks don't work reliably through a connection pooler.
# Self-hosted Postgres: same value as DATABASE_URL.
# Neon: the connection string WITHOUT "-pooler" in the hostname.
DIRECT_URL="postgresql://expense_tracker:CHANGE_ME@localhost:5432/expense_tracker?schema=public"

# Random secret used to sign login session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# This is a multi-user app — every user's login (email + bcrypt password
# hash) lives in the database, created via the /signup page or the one-time
# migration script (see MIGRATING_TO_MULTI_USER.md). The two variables below
# are NOT read by the running app; they're only used once, by `npm run
# db:seed`, to create the very first (admin) user when migrating a database
# that predates multi-user support.

# Email for that first admin user.
ADMIN_EMAIL="CHANGE_ME@example.com"

# Bcrypt hash of that admin's password, base64-encoded (never store the plain
# password). It's base64-encoded because a raw bcrypt hash is full of `$`
# characters (e.g. $2b$10$...), and Next.js's .env variable-expansion silently
# mangles those (it treats `$word` as an interpolation, not literal text).
# Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password-here', 10)).toString('base64'))"
AUTH_PASSWORD_HASH_BASE64="CHANGE_ME_BASE64_BCRYPT_HASH"
