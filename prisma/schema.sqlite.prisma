// Local-dev-only variant of schema.prisma, targeting SQLite instead of PostgreSQL.
// Prisma doesn't support picking a datasource provider by env var, and SQLite
// doesn't support the `@db.Decimal(12,2)` / `@db.Date` native type attributes
// (Postgres-specific) — otherwise identical to schema.prisma.
//
// If you change models in schema.prisma, mirror the change here too.
// Usage: see LOCAL_DEV.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  isAdmin      Boolean    @default(false)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  currency String @default("INR")
  locale   String @default("en-IN")
  timezone String @default("Asia/Kolkata")
  cardVisibility String @default("{}")

  accounts           Account[]
  transactions       Transaction[]
  emis               Emi[]
  recurringTemplates RecurringTemplate[]
  categories         Category[]
  mediums            Medium[]
  accountRoles       AccountRole[]

  @@map("users")
}

enum AccountType {
  BANK
  CREDIT
  PREPAID
  CASH
  WALLET
}

enum TransactionType {
  EXPENSE
  INCOME
  SELF_TRANSFER
}

model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType
  role           String      @default("General")
  openingBalance Decimal     @default(0)
  creditLimit    Decimal?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  includeInAvailableBalance Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  addOnOfAccountId String?
  addOnOf          Account?  @relation("AddOnCard", fields: [addOnOfAccountId], references: [id], onDelete: SetNull)
  addOnCards       Account[] @relation("AddOnCard")

  sourceTransactions Transaction[] @relation("SourceAccount")
  creditTransactions Transaction[] @relation("CreditAccount")
  emisOnCard         Emi[]         @relation("EmiCard")
  recurringTemplates            RecurringTemplate[] @relation("RecurringAccount")
  recurringDestinationTemplates RecurringTemplate[] @relation("RecurringDestinationAccount")
  mediumDefaults                Medium[]

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id       String          @id @default(uuid())
  type     TransactionType
  date     DateTime
  amount   Decimal
  purpose  String
  category String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  medium String?

  sourceAccountId String?
  sourceAccount   Account? @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)

  creditAccountId String?
  creditAccount   Account? @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)

  destination String?

  recurringTemplateId String?
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emiInstallment EmiInstallment?
  emiDeduction   Emi?

  @@index([date])
  @@index([type])
  @@index([userId])
  @@index([recurringTemplateId])
  @@map("transactions")
}

model Emi {
  id            String   @id @default(uuid())
  totalAmount   Decimal
  monthlyAmount Decimal
  periodMonths  Int
  person        String
  isOwn         Boolean  @default(false)
  isOneTime     Boolean  @default(false)
  startDate     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardAccountId String?
  cardAccount   Account? @relation("EmiCard", fields: [cardAccountId], references: [id], onDelete: SetNull)

  deductTransactionId String?      @unique
  deductTransaction   Transaction? @relation(fields: [deductTransactionId], references: [id], onDelete: SetNull)

  installments EmiInstallment[]

  @@index([userId])
  @@map("emis")
}

model EmiInstallment {
  id                String   @id @default(uuid())
  emiId             String
  emi               Emi      @relation(fields: [emiId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal

  receivedTransactionId String?      @unique
  receivedTransaction   Transaction? @relation(fields: [receivedTransactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([emiId, installmentNumber])
  @@map("emi_installments")
}

enum RecurringFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

model RecurringTemplate {
  id       String          @id @default(uuid())
  name     String
  type     TransactionType
  amount   Decimal
  category String

  medium String?

  frequency RecurringFrequency @default(MONTHLY)

  dayOfMonth Int
  dueMonth   Int?

  startDate DateTime?
  endDate   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation("RecurringAccount", fields: [accountId], references: [id], onDelete: Restrict)

  destinationAccountId String?
  destinationAccount   Account? @relation("RecurringDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  skips        RecurringSkip[]

  @@index([userId])
  @@map("recurring_templates")
}

model RecurringSkip {
  id         String            @id @default(uuid())
  templateId String
  template   RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  periodKey  String
  createdAt  DateTime          @default(now())

  @@unique([templateId, periodKey])
  @@map("recurring_skips")
}

model Category {
  id        String          @id @default(uuid())
  name      String
  type      TransactionType
  createdAt DateTime        @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
  @@index([userId])
  @@map("categories")
}

model Medium {
  id                  String   @id @default(uuid())
  name                String
  allowedAccountTypes String   @default("")
  createdAt           DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultAccountId String?
  defaultAccount   Account? @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)

  @@unique([userId, name])
  @@index([userId])
  @@map("mediums")
}

model AccountRole {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("account_roles")
}
