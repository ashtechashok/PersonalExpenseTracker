generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Neon's "-pooler" host) — used by the running
  // app, where many short-lived serverless function invocations each need
  // their own connection.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only by `prisma migrate deploy` for
  // DDL/advisory locks, which don't work reliably through a pooler.
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

// Each user owns a fully separate set of accounts/transactions/EMIs — this
// is a multi-tenant app, not a shared household ledger. New signups start
// PENDING and can't log in until an admin approves them (see /users).
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  isAdmin      Boolean    @default(false)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Per-user display/locale settings — everything else in the app is
  // per-user data already; these are the only formerly-hardcoded,
  // India-specific bits (currency symbol, date/number formatting, "today").
  // currency: ISO 4217 code (e.g. "INR"); locale: BCP 47 tag driving both
  // Intl.NumberFormat and Intl.DateTimeFormat (e.g. "en-IN"); timezone: IANA
  // zone name used to compute "today" server-side (e.g. "Asia/Kolkata").
  currency String @default("INR")
  locale   String @default("en-IN")
  timezone String @default("Asia/Kolkata")

  // Which Dashboard summary cards are hidden — keyed by the card's key (a
  // fixed summary field name, or "role:<name>" for a per-account-role card).
  // A key absent from this object means "visible" (the default for every
  // card), so this only ever needs to record the ones a user turned off.
  // Server-side (not localStorage) so it's the same on every device/browser.
  // A JSON-encoded string, not the Json scalar type: Prisma's SQLite
  // connector can't express a `{}` default for a real Json column.
  cardVisibility String @default("{}")

  accounts           Account[]
  transactions       Transaction[]
  emis               Emi[]
  recurringTemplates RecurringTemplate[]
  categories         Category[]
  mediums            Medium[]
  accountRoles       AccountRole[]

  @@map("users")
}

enum AccountType {
  BANK
  CREDIT
  PREPAID
  CASH
  // A digital/mobile wallet balance (e.g. Amazon Pay, a Paytm wallet) as
  // distinct from a PREPAID card — behaves like BANK/PREPAID/CASH for
  // balance math (only CREDIT inverts debit/credit), just its own label.
  WALLET
}

enum TransactionType {
  EXPENSE
  INCOME
  // Money moved between two of your own accounts — debits the source like
  // an expense, credits the destination, but never counts as spending or
  // income (see summarizeTransactions in lib/balances.ts).
  SELF_TRANSFER
}

model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType
  // A free-text per-user label (e.g. "Emergency Fund", "Salary Account") —
  // not an enum, and not a foreign key: like Transaction.category, deleting
  // a role from a user's list (see model AccountRole below) never touches an
  // account that already carries it. Every distinct role value in use
  // automatically gets its own summary total on the Dashboard (see
  // summarizeAccounts in lib/balances.ts) — not just one hardcoded name.
  role           String      @default("General")
  // Balance/outstanding as of account creation. Current value is opening
  // balance plus the net effect of every transaction referencing this
  // account — never mutated directly, so it can't drift out of sync.
  openingBalance Decimal     @default(0) @db.Decimal(12, 2)
  creditLimit    Decimal?    @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Whether this account's balance counts towards the "Available Balance"
  // summary — a per-account toggle independent of role/type, so any role's
  // account can opt in and an ordinary one can opt out.
  // Ignored for CREDIT accounts (they're never counted there regardless).
  includeInAvailableBalance Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // An add-on/supplementary credit card shares its parent's credit limit
  // instead of having its own — only one level deep (a parent can't itself
  // be an add-on). When set, this account's own creditLimit is ignored.
  addOnOfAccountId String?
  addOnOf          Account?  @relation("AddOnCard", fields: [addOnOfAccountId], references: [id], onDelete: SetNull)
  addOnCards       Account[] @relation("AddOnCard")

  sourceTransactions Transaction[] @relation("SourceAccount")
  creditTransactions Transaction[] @relation("CreditAccount")
  emisOnCard         Emi[]         @relation("EmiCard")
  recurringTemplates            RecurringTemplate[] @relation("RecurringAccount")
  recurringDestinationTemplates RecurringTemplate[] @relation("RecurringDestinationAccount")
  mediumDefaults                Medium[]

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id       String          @id @default(uuid())
  type     TransactionType
  date     DateTime        @db.Date
  amount   Decimal         @db.Decimal(12, 2)
  purpose  String
  category String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Expense-only: how it was paid (Cash / Card / Paytm)
  medium String?

  // Expense: account debited (null when medium = Cash).
  sourceAccountId String?
  sourceAccount   Account? @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)

  // Income: account credited (required). Expense: optional transfer leg
  // (e.g. an Emergency Fund deposit also credits the Jio account).
  creditAccountId String?
  creditAccount   Account? @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)

  destination String?

  // Set when this transaction is a logged occurrence of a recurring
  // template (see RecurringTemplate) — self-healing like the EMI links
  // above: deleting the transaction clears this automatically.
  recurringTemplateId String?
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emiInstallment EmiInstallment?
  emiDeduction   Emi?

  @@index([date])
  @@index([type])
  @@index([userId])
  @@index([recurringTemplateId])
  @@map("transactions")
}

// A credit-card EMI purchase — your own, or one you fronted for someone else
// (their installments show up in "Yet to Receive" until marked received) —
// or, when isOneTime, a single lump-sum loan to someone (periodMonths is
// always 1 in that case).
model Emi {
  id            String   @id @default(uuid())
  totalAmount   Decimal  @db.Decimal(12, 2)
  monthlyAmount Decimal  @db.Decimal(12, 2)
  periodMonths  Int
  person        String
  isOwn         Boolean  @default(false)
  isOneTime     Boolean  @default(false)
  startDate     DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The credit card this EMI is on (regular EMIs only, not one-time loans).
  // Its full total amount is blocked against that card's available limit for
  // as long as this record exists — mirrors how banks block the whole EMI
  // principal upfront, not just what's been billed so far.
  cardAccountId String?
  cardAccount   Account? @relation("EmiCard", fields: [cardAccountId], references: [id], onDelete: SetNull)

  // One-time loans deduct from an account immediately on creation — this is
  // that Expense transaction. Same self-healing pattern as receivedTransactionId:
  // deleting it (from the Transactions page) clears this field automatically.
  deductTransactionId String?      @unique
  deductTransaction   Transaction? @relation(fields: [deductTransactionId], references: [id], onDelete: SetNull)

  installments EmiInstallment[]

  @@index([userId])
  @@map("emis")
}

model EmiInstallment {
  id                String   @id @default(uuid())
  emiId             String
  emi               Emi      @relation(fields: [emiId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime @db.Date
  amount            Decimal  @db.Decimal(12, 2)

  // Set when marked received: the actual Income transaction that credited an
  // account. Deleting that transaction (from the Transactions page) clears
  // this automatically, so "received" is always derived from its presence —
  // never a separately-mutated status flag that could drift out of sync.
  receivedTransactionId String?      @unique
  receivedTransaction   Transaction? @relation(fields: [receivedTransactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([emiId, installmentNumber])
  @@map("emi_installments")
}

enum RecurringFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

// A recurring bill/income you log yourself each period rather than one the
// app auto-creates — real-world due dates drift (early/late), so an
// auto-created transaction dated on a fixed schedule would make Available
// Balance wrong until the real payment happened. Instead this is just a
// reminder + default account; "paying" it always creates a real Transaction
// dated whenever you actually act, exactly like the EMI installment flow.
model RecurringTemplate {
  id       String          @id @default(uuid())
  name     String
  type     TransactionType // EXPENSE or INCOME only — enforced in the app layer.
  amount   Decimal         @db.Decimal(12, 2)
  category String

  // Expense-only: how it's normally paid (Cash / Card / Paytm).
  medium String?

  frequency RecurringFrequency @default(MONTHLY)

  // Reminder-only hint of which day is usually due — the logged transaction
  // is always dated whenever you actually mark it paid. For MONTHLY, this is
  // the day of every month; for QUARTERLY, the day within each quarter's
  // last month (Mar/Jun/Sep/Dec); for YEARLY, the day within dueMonth.
  dayOfMonth Int

  // YEARLY-only: which calendar month (1-12) this is due in.
  dueMonth Int?

  // Optional bounded window for something with a defined start/end (e.g. a
  // fixed-term subscription or insurance premium) — outside this range the
  // template shows as "Starts"/"Ended" instead of due. Independent of
  // isActive, which is for indefinite manual pausing.
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The default account this moves against — debited for an expense,
  // credited for an income. A single occurrence can still be logged against
  // a different account ("paid with a different account") without changing
  // this default.
  accountId String
  account   Account @relation("RecurringAccount", fields: [accountId], references: [id], onDelete: Restrict)

  // Expense-only, optional second leg: also credits this account, for a
  // payment that's really a transfer into savings (e.g. an Emergency Fund or
  // SSA deposit) — mirrors Transaction.creditAccountId's same optional use
  // for a regular expense.
  destinationAccountId String?
  destinationAccount   Account? @relation("RecurringDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  skips        RecurringSkip[]

  @@index([userId])
  @@map("recurring_templates")
}

// One calendar period (e.g. "2026-08") that was explicitly cancelled for a
// template — no transaction was, or will be, created for it. Reversible:
// deleting this row (undo) puts the period back to "due".
model RecurringSkip {
  id         String            @id @default(uuid())
  templateId String
  template   RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  periodKey  String // "YYYY-MM"
  createdAt  DateTime          @default(now())

  @@unique([templateId, periodKey])
  @@map("recurring_skips")
}

// A per-user spending/income category — replaces a single app-wide fixed
// list, so each user can add/rename/remove their own. Transaction.category
// and RecurringTemplate.category stay plain strings (not a foreign key) —
// deleting a category here only removes it from the picker for new entries;
// it never touches already-logged history. type is always EXPENSE or
// INCOME, enforced in the app layer (never SELF_TRANSFER, which always gets
// a fixed category server-side instead).
model Category {
  id        String          @id @default(uuid())
  name      String
  type      TransactionType
  createdAt DateTime        @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
  @@index([userId])
  @@map("categories")
}

// A per-user payment medium (Cash/Card/Paytm/etc.) for expenses — replaces a
// single app-wide fixed list, plus the account-picker rules that used to be
// hardcoded per medium name (e.g. "Paytm defaults to whichever account is
// named 'Coral RuPay'"). Both of those are now data on this row instead:
// allowedAccountTypes restricts which account types are offered as the
// source when this medium is picked, and defaultAccountId pre-selects one.
model Medium {
  id        String   @id @default(uuid())
  name      String
  // Comma-separated AccountType values (e.g. "CREDIT,PREPAID") — empty
  // string means "any account type". A plain string, not a native scalar
  // list: SQLite has no list-type support, unlike Postgres.
  allowedAccountTypes String @default("")
  createdAt           DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultAccountId String?
  defaultAccount   Account? @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)

  @@unique([userId, name])
  @@index([userId])
  @@map("mediums")
}

// A per-user account role label (e.g. "Emergency Fund", "Salary Account") —
// replaces the single app-wide AccountRole enum. Not referenced by Account
// via a foreign key: Account.role just stores the name string directly
// (like Transaction.category), so deleting a role here never touches an
// account that already carries it. Every distinct role value actually in
// use gets its own summary total on the Dashboard automatically — nothing
// here is specially tied to any particular name.
model AccountRole {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("account_roles")
}
